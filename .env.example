# Copy to .env and adjust. Never commit the real .env or any credentials.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Database ---
# Local (outside Docker): point at your PostgreSQL. If unset, development falls back to SQLite.
DATABASE_URL=postgresql://cloudguard:change-me@localhost:5432/cloudguard
# Used by compose.yaml to create the database container.
POSTGRES_USER=cloudguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudguard

# --- Upload limits for untrusted configuration JSON ---
MAX_UPLOAD_BYTES=1000000
MAX_JSON_DEPTH=12

# --- Meta Model API (wired up on Day 5; keep configurable) ---
META_API_KEY=
META_MODEL_ID=
META_API_BASE_URL=
