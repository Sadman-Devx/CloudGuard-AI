      ]
    },
    {
      "id": "sg-app",
      "vpc_id": "vpc-main",
      "name": "app",
      "description": "Application tier",
      "ingress": [
        { "protocol": "tcp", "from_port": 8000, "to_port": 8000, "source_security_group_id": "sg-web" }
      ],
      "egress": [
        { "protocol": "tcp", "from_port": 5432, "to_port": 5432, "destination_security_group_id": "sg-db" }
      ]
    },
    {
      "id": "sg-db",
      "vpc_id": "vpc-main",
      "name": "db",
      "description": "Database allows PostgreSQL from the web tier only (app tier was forgotten)",
      "ingress": [
        { "protocol": "tcp", "from_port": 5432, "to_port": 5432, "source_security_group_id": "sg-web" }
      ],
      "egress": []
