      "ingress": [
        { "protocol": "tcp", "from_port": 443, "to_port": 443, "cidr": "0.0.0.0/0" }
      ],
      "egress": [
        { "protocol": "tcp", "from_port": 8000, "to_port": 8000, "destination_security_group_id": "sg-app" },
