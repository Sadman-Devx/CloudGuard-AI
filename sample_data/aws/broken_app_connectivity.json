      "availability_zone": "us-east-1a",
      "name": "public"
    },
    {
      "id": "subnet-private",
      "vpc_id": "vpc-main",
      "cidr": "10.0.2.0/24",
      "route_table_id": "rtb-private",
      "availability_zone": "us-east-1a",
      "name": "private"
    }
  ],
  "security_groups": [
    {
      "id": "sg-web",
      "vpc_id": "vpc-main",
      "name": "web",
