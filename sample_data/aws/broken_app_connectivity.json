{
  "schema_version": "1.0",
  "name": "App cannot reach database",
  "region": "us-east-1",
  "vpcs": [
    { "id": "vpc-main", "cidr": "10.0.0.0/16", "name": "main" }
  ],
  "internet_gateways": [
    { "id": "igw-main", "vpc_id": "vpc-main" }
  ],
  "route_tables": [
    {
      "id": "rtb-public",
      "vpc_id": "vpc-main",
      "name": "public",
      "routes": [
        { "destination_cidr": "10.0.0.0/16", "target": "local" },
        { "destination_cidr": "0.0.0.0/0", "target": "igw-main" }
